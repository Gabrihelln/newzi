# Local development template. Copy to .env; never commit the resulting file.
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8090
DEFAULT_TIMEZONE=America/Sao_Paulo
DEFAULT_LANGUAGE=pt-BR

# Local auth can stay disabled until Firebase Admin credentials are configured.
FIREBASE_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=
# Absolute path to a private Firebase Admin service-account JSON, outside Git.
GOOGLE_APPLICATION_CREDENTIALS=

# SQLite defaults to backend/data/product_backend.sqlite3. PostgreSQL is also supported;
# the schema is created and upgraded automatically by versioned migrations at startup.
# DATABASE_URL=sqlite:///backend/data/product_backend.sqlite3
# DATABASE_URL=postgresql://newzi:password@localhost:5432/newzi
# LOG_LEVEL=WARNING
# ACCESS_LOG=false
ENABLE_DEV_ENDPOINTS=true
CORS_ALLOW_ORIGINS=

# Briefing, audio and background worker.
BRIEFING_GENERATOR=engine
BRIEFING_GENERATION_LEAD_MINUTES=30
GENERATION_MAX_RETRIES=2
WORKER_JOB_TIMEOUT_MINUTES=30
DELIVERY_WORKER_POLL_SECONDS=10
WORKER_BATCH_SIZE=20
NEWS_REFRESH_INTERVAL_SECONDS=600
# A RUNNING ingestion older than this is marked FAILED so a crashed run cannot block refreshes.
INGESTION_TIMEOUT_MINUTES=30
# Worker roles this process runs (comma or colon separated; default all):
# news, schedule, generation, audio, notifications, breaking, retention.
# Split them across processes with deploy/systemd/newzi-worker@.service.
# WORKER_ROLES=all
# /health/worker answers 503 when a role has not completed a cycle within this window.
# WORKER_STALE_SECONDS=300
# Per worker cycle: audio jobs (a few in parallel) and push notifications are processed in batches.
# AUDIO_BATCH_SIZE=6
# AUDIO_WORKERS=2
# NOTIFICATION_BATCH_SIZE=200
# Daily retention: unused audio variants, telemetry/finished jobs, articles older than the window.
# RETENTION_AUDIO_VARIANT_DAYS=7
# RETENTION_TELEMETRY_DAYS=30
# RETENTION_CONTENT_DAYS=90
# A verified Firebase token is reused this long (revocations apply within it; 0 disables).
# FIREBASE_TOKEN_CACHE_SECONDS=60
# ARTICLE_IMAGE_CACHE_MAX_FILES=500
AUDIO_ENABLED=true
TTS_PROVIDER=edge-tts
TTS_VOICE=newzi_lucas
# Official Azure AI Speech (same voices as edge-tts). With a key, it stands in automatically
# when edge-tts fails (TTS_FALLBACK_PROVIDER=none disables that), or set TTS_PROVIDER=azure-tts.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=brazilsouth
# TTS_FALLBACK_PROVIDER=azure-tts
# TTS_FALLBACK_COOLDOWN_SECONDS=600
# AUDIO_STORAGE_ROOT=backend/data/audio
# NEWS_AUDIO_TMP=backend/data/audio/tmp
NOTIFICATIONS_ENABLED=true
PUSH_PROVIDER=development
# PUSH_PROVIDER=fcm sends through Firebase Admin using GOOGLE_APPLICATION_CREDENTIALS;
# the SDK refreshes OAuth tokens itself. Defaults to FIREBASE_PROJECT_ID.
# FCM_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
# Breaking-news push (users opt in with breaking_news_enabled): an event at least
# BREAKING_MIN_SOURCES outlets started covering within BREAKING_WINDOW_MINUTES.
# BREAKING_NEWS_ENABLED=true
# BREAKING_MIN_SOURCES=3
# BREAKING_WINDOW_MINUTES=180
# BREAKING_MAX_PER_DAY=2
# BREAKING_MIN_GAP_MINUTES=180
# BREAKING_QUIET_HOURS=22-7
# BREAKING_MAX_DELAY_MINUTES=60
# BREAKING_CHECK_SECONDS=300

# The engine defaults to engine/data. Set an absolute durable path in production.
# backend/product_api.py and engine/main.py load this file from the repository root;
# variables already set in the process (systemd EnvironmentFile) take precedence.
# NEWS_ENGINE_DATA_DIR=engine/data

# Brasileirão results, fixtures and table on the Home (free key at https://www.football-data.org).
# Without a key the football card is simply not shown.
# FOOTBALL_DATA_TOKEN=

# Newzi Premium purchases through Google Play Billing. Leave off until the store products and the
# billing webhook are set up: the app then shows the plans in Profile › Assinatura e plano without selling.
# BILLING_ENABLED=0
# Links shown on the subscription screen (Google Play requires them before selling).
# TERMS_URL=
# PRIVACY_URL=
