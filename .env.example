# Local development template. Copy to .env; never commit the resulting file.
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8090
DEFAULT_TIMEZONE=America/Sao_Paulo
DEFAULT_LANGUAGE=pt-BR

# Local auth can stay disabled until Firebase Admin credentials are configured.
FIREBASE_AUTH_ENABLED=false
FIREBASE_PROJECT_ID=
# Absolute path to a private Firebase Admin service-account JSON, outside Git.
GOOGLE_APPLICATION_CREDENTIALS=

# SQLite defaults to backend/data/product_backend.sqlite3.
# DATABASE_URL=sqlite:///backend/data/product_backend.sqlite3
ENABLE_DEV_ENDPOINTS=true
CORS_ALLOW_ORIGINS=

# Briefing, audio and background worker.
BRIEFING_GENERATOR=engine
BRIEFING_GENERATION_LEAD_MINUTES=30
GENERATION_MAX_RETRIES=2
WORKER_JOB_TIMEOUT_MINUTES=30
DELIVERY_WORKER_POLL_SECONDS=10
WORKER_BATCH_SIZE=20
NEWS_REFRESH_INTERVAL_SECONDS=600
AUDIO_ENABLED=true
TTS_PROVIDER=edge-tts
TTS_VOICE=newzi_lucas
# AUDIO_STORAGE_ROOT=backend/data/audio
# NEWS_AUDIO_TMP=backend/data/audio/tmp
NOTIFICATIONS_ENABLED=true
PUSH_PROVIDER=development
# FCM_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
# FCM_ACCESS_TOKEN=

# The engine defaults to engine/data. Set an absolute durable path in production.
# The engine process reads environment variables directly; backend/product_api.py
# also loads the repository-root .env file.
# NEWS_ENGINE_DATA_DIR=engine/data
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2
# OLLAMA_TIMEOUT_SECONDS=45
# OLLAMA_MAX_RETRIES=1
# OLLAMA_WARMUP=0
# OLLAMA_MAX_OUTPUT_TOKENS=256
# OLLAMA_CONTEXT_LENGTH=4096
# BRIEFING_TARGET_COUNT=10
# NEWS_SUMMARY_EVIDENCE_CHARS=1200
