# Analytics Newzi (painel.newzi.app): the panel's static site from the checkout, and only the /api/v1/admin routes
# of the API. Install as /etc/nginx/sites-available/newzi-painel, then issue the certificate with
# `certbot --nginx -d painel.newzi.app` (Certbot adds the 443 server block and the redirect).
server {
    listen 80;
    server_name painel.newzi.app;

    root /opt/newzi/admin;
    index index.html;

    # The panel is private: no indexing, no framing, no third-party code.
    add_header X-Robots-Tag "noindex, nofollow" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" always;
    add_header Cache-Control "no-cache" always;

    location = /robots.txt {
        default_type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    location /api/v1/admin/ {
        proxy_pass http://127.0.0.1:8090;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    # Nothing else of the API is served on this host.
    location /api/ {
        return 404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
