rules_version = '2';

// The app keeps no data in Firestore: profiles, preferences and notification settings live in the
// product backend's database (see docs/FIREBASE_ARCHITECTURE.md). Nothing may read or write here.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
